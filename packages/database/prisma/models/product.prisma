enum ProductType {
    STOCKABLE
    SERVICE
    NON_STOCK
}

enum TrackingMode {
    NONE
    LOT
    SERIAL
}

model UnitOfMeasure {
    id        String  @id @default(cuid())
    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    name   String // "Piece", "Case", "Kilogram"
    symbol String // "pc", "cs", "kg"

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    products        Product[]                 @relation("ProductBaseUom")
    conversionsFrom UnitOfMeasureConversion[] @relation("FromUom")
    conversionsTo   UnitOfMeasureConversion[] @relation("ToUom")

    @@unique([companyId, name])
    @@index([companyId])
    @@map("uoms")
}

// e.g. 1 Case = 12 Piece → fromUomId=Case, toUomId=Piece, factor=12
model UnitOfMeasureConversion {
    id        String  @id @default(cuid())
    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    fromUomId String        @map("from_uom_id")
    fromUom   UnitOfMeasure @relation("FromUom", fields: [fromUomId], references: [id], onDelete: Restrict)

    toUomId String        @map("to_uom_id")
    toUom   UnitOfMeasure @relation("ToUom", fields: [toUomId], references: [id], onDelete: Restrict)

    factor Decimal @db.Decimal(18, 6) // multiply fromUom qty by factor to get toUom qty

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([fromUomId, toUomId])
    @@index([companyId])
    @@map("uom_conversions")
}

model ProductCategory {
    id        String  @id @default(cuid())
    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    name        String
    description String?

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    products Product[]

    @@unique([companyId, name])
    @@index([companyId])
    @@map("product_categories")
}

model Product {
    id        String  @id @default(cuid())
    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    sku         String?
    name        String
    description String?
    barcode     String?

    type         ProductType  @default(STOCKABLE)
    trackingMode TrackingMode @default(NONE) @map("tracking_mode")

    categoryId String?          @map("category_id")
    category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

    baseUomId String        @map("base_uom_id")
    baseUom   UnitOfMeasure @relation("ProductBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)

    // Convenience price until PriceList exists. Not the real selling price.
    // Remove this field when PriceList is implemented.
    defaultSalesPrice Decimal? @map("default_sales_price") @db.Decimal(18, 4)
    defaultCost       Decimal? @map("default_cost") @db.Decimal(18, 4)

    isPurchasable Boolean @default(true) @map("is_purchasable")
    isSellable    Boolean @default(true) @map("is_sellable")
    isActive      Boolean @default(true) @map("is_active")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    @@unique([companyId, sku])
    @@index([companyId, name])
    @@index([categoryId])
    @@index([baseUomId])
    @@map("products")
}
