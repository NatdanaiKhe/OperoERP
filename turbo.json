{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "envMode": "loose",
      "dependsOn": [
        "@opero/config#build"
      ],
      "outputs": [
        "src/generated/prisma/**"
      ]
    },
    "db:migrate": {
      "cache": false,
      "envMode": "loose",
      "dependsOn": [
        "@opero/config#build"
      ]
    },
    "db:migrate-dev": {
      "cache": false,
      "envMode": "loose",
      "dependsOn": [
        "@opero/config#build",
        "database#build"
      ]
    },
    "db:deploy": {
      "cache": false,
      "envMode": "loose",
      "dependsOn": [
        "@opero/config#build"
      ]
    },
    "db:seed": {
      "cache": false,
      "envMode": "loose",
      "dependsOn": [
        "@opero/config#build",
        "database#build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "REDIS_URL",
        "NEXT_PUBLIC_API_URL",
        "INFISICAL_DOMAIN",
        "INFISICAL_CUSTOM_HEADERS"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck",
        "database#db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "database#db:generate"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "envMode": "loose"
    }
  }
}